# Dockerfile pour créer un binaire PHP 100% statique avec musl
FROM alpine:3.19 as builder

ARG PHP_VERSION=8.2.14

# Installation des dépendances de build
RUN apk add --no-cache \
    autoconf \
    automake \
    libtool \
    pkgconf \
    gcc \
    g++ \
    make \
    cmake \
    wget \
    curl \
    bison \
    re2c \
    linux-headers \
    musl-dev \
    openssl-dev \
    openssl-libs-static \
    curl-dev \
    curl-static \
    libxml2-dev \
    libxml2-static \
    sqlite-dev \
    sqlite-static \
    zlib-dev \
    zlib-static \
    bzip2-dev \
    bzip2-static \
    readline-dev \
    readline-static \
    libpng-dev \
    libpng-static \
    libjpeg-turbo-dev \
    libjpeg-turbo-static \
    freetype-dev \
    freetype-static \
    oniguruma-dev \
    libzip-dev \
    icu-dev \
    icu-static \
    libffi-dev \
    gettext-dev \
    gettext-static

ENV BUILD_DIR=/tmp/php-build
ENV INSTALL_DIR=/tmp/php-static

# Création des répertoires
RUN mkdir -p ${BUILD_DIR} ${INSTALL_DIR}

# Téléchargement de PHP
WORKDIR ${BUILD_DIR}
RUN wget -q "https://www.php.net/distributions/php-${PHP_VERSION}.tar.gz" && \
    tar -xzf "php-${PHP_VERSION}.tar.gz"

WORKDIR ${BUILD_DIR}/php-${PHP_VERSION}

# Configuration pour un build 100% statique
RUN ./configure \
    --prefix=${INSTALL_DIR} \
    --disable-all \
    --enable-static \
    --disable-shared \
    --enable-cli \
    --enable-fpm \
    --with-config-file-path=${INSTALL_DIR}/etc \
    --with-config-file-scan-dir=${INSTALL_DIR}/etc/conf.d \
    --enable-phar \
    --enable-session \
    --enable-opcache \
    --enable-mysqlnd \
    --enable-pdo \
    --with-pdo-mysql=mysqlnd \
    --with-pdo-sqlite \
    --enable-dom \
    --enable-xml \
    --enable-simplexml \
    --enable-xmlreader \
    --enable-xmlwriter \
    --with-libxml \
    --with-bz2 \
    --enable-calendar \
    --enable-ctype \
    --enable-exif \
    --enable-fileinfo \
    --enable-ftp \
    --enable-mbstring \
    --with-mysqli=mysqlnd \
    --enable-posix \
    --with-readline \
    --enable-shmop \
    --enable-sockets \
    --with-sqlite3 \
    --enable-sysvmsg \
    --enable-sysvsem \
    --enable-sysvshm \
    --with-zip \
    --with-zlib \
    --with-openssl \
    --enable-pcntl \
    --enable-bcmath \
    --enable-filter \
    --enable-tokenizer \
    --enable-zts=no \
    --disable-debug \
    --disable-rpath \
    --without-pear \
    --disable-cgi \
    --disable-phpdbg \
    --enable-embed=no \
    CFLAGS="-Os -ffunction-sections -fdata-sections" \
    CXXFLAGS="-Os -ffunction-sections -fdata-sections"

# Compilation avec linking statique
RUN make -j$(nproc) LDFLAGS="-all-static" EXTRA_LIBS="-lbz2 -lz -lssl -lcrypto -lsqlite3 -lxml2 -llzma -lreadline -lncursesw -lpthread -ldl -lm"

# Installation
RUN make install

# Strip des binaires pour réduire la taille
RUN strip --strip-all ${INSTALL_DIR}/bin/php && \
    strip --strip-all ${INSTALL_DIR}/sbin/php-fpm

# Création de la configuration PHP
RUN mkdir -p ${INSTALL_DIR}/etc/conf.d && \
    echo '[PHP]' > ${INSTALL_DIR}/etc/php.ini && \
    echo 'engine = On' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'short_open_tag = Off' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'precision = 14' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'output_buffering = 4096' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'memory_limit = 128M' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'display_errors = Off' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'log_errors = On' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'default_charset = UTF-8' >> ${INSTALL_DIR}/etc/php.ini && \
    echo '' >> ${INSTALL_DIR}/etc/php.ini && \
    echo '[opcache]' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'opcache.enable=1' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'opcache.enable_cli=1' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'opcache.memory_consumption=128' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'opcache.max_accelerated_files=4000' >> ${INSTALL_DIR}/etc/php.ini && \
    echo '' >> ${INSTALL_DIR}/etc/php.ini && \
    echo '[Date]' >> ${INSTALL_DIR}/etc/php.ini && \
    echo 'date.timezone = UTC' >> ${INSTALL_DIR}/etc/php.ini

# Création de la structure finale
RUN mkdir -p ${INSTALL_DIR}/var/log ${INSTALL_DIR}/var/run ${INSTALL_DIR}/tmp

# Stage final - copie uniquement les binaires
FROM scratch
COPY --from=builder /tmp/php-static /

# Le binaire est maintenant 100% statique et autonome
